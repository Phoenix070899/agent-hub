#!/usr/bin/env python3
"""Claude Code Notification hook for Workers: report a blocked Worker to the Orchestrator.

A Worker stuck at a permission prompt or idle at its input never sends an Orca message on
its own, so this hook sends a `question` to the Run for it. Configured in settings/worker.json;
reads the hook JSON on stdin and needs HUB_RUN_ID (set by hub-worker) and ORCA_TERMINAL_HANDLE.
Always exits 0: a reporting failure must never break the Worker.
"""
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

STATE_DIR = Path.home() / ".agent-hub" / "notify"
DEBOUNCE_SECONDS = 600
SCREEN_LINES = 25


def orca_json(*args):
    result = subprocess.run(["orca", *args, "--json"], capture_output=True, text=True, timeout=30)
    return json.loads(result.stdout) if result.stdout.strip() else {}


def dispatch_active(run_id, handle):
    """True while this terminal's newest Dispatch is unsettled (or when that cannot be told)."""
    try:
        workers = orca_json("orchestration", "worker-list", "--run", run_id)["result"]["workers"]
    except Exception:
        return True
    mine = [w for w in workers if w.get("agentTerminalHandle") == handle]
    return not mine or mine[0].get("dispatchStatus") == "dispatched"


def screen(handle):
    try:
        tail = orca_json("terminal", "read", "--screen", "--terminal", handle)["result"]["terminal"]["tail"]
    except Exception:
        return "(screen unavailable)"
    lines = [line.rstrip() for line in tail if line.strip()]
    return "\n".join(lines[-SCREEN_LINES:])


def debounced(handle, key):
    """True if this exact notification was already reported recently; records it otherwise."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state = STATE_DIR / handle
    digest = hashlib.sha256(key.encode()).hexdigest()
    try:
        last_digest, last_time = state.read_text().split()
        if last_digest == digest and time.time() - float(last_time) < DEBOUNCE_SECONDS:
            return True
    except (OSError, ValueError):
        pass
    state.write_text(f"{digest} {time.time()}")
    return False


def main():
    run_id = os.environ.get("HUB_RUN_ID")
    handle = os.environ.get("ORCA_TERMINAL_HANDLE")
    if not run_id or not handle:
        return
    event = json.loads(sys.stdin.read() or "{}")
    kind = event.get("notification_type") or "notification"
    message = event.get("message") or event.get("title") or ""
    if kind == "idle_prompt" and not dispatch_active(run_id, handle):
        return  # idle after worker_done is the expected end state, not a blocker
    if debounced(handle, f"{kind}\n{message}"):
        return
    body = f"{message}\n\nWorker screen (last {SCREEN_LINES} lines):\n{screen(handle)}"
    subprocess.run(["orca", "orchestration", "send", "--run", run_id, "--type", "question",
                    "--from", handle, "--subject", f"Blocked: {kind}", "--body", body, "--json"],
                   capture_output=True, text=True, timeout=30)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:  # never fail the Worker's session over a report
        print(f"hub-notify: {error}", file=sys.stderr)
    sys.exit(0)
