#!/bin/sh
# Start (or resume) the Agent Hub Orchestrator for the repo in the current directory.
set -e
AGENT_HUB="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
export AGENT_HUB
if ! orca status --json >/dev/null 2>&1; then
  echo "hub: Orca is not running; open Orca and run hub from an Orca terminal" >&2
  exit 1
fi
REPO="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO"
PROMPT="$(sed "s|\$AGENT_HUB|$AGENT_HUB|g" "$AGENT_HUB/orchestrator.md")

# Preferences

$(cat "$AGENT_HUB/memory/preferences.md")

Repo for this Hub Session: $REPO"
exec claude -n "hub: $(basename "$REPO")" --plugin-dir "$AGENT_HUB/mod" --add-dir "$AGENT_HUB" --append-system-prompt "$PROMPT" "$@"
