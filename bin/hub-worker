#!/usr/bin/env python3
"""Start one supervised Worker from an Agent Profile in its own Orca terminal.

Usage:
  hub-worker <profile> (--spec <text> | --spec-file <path>) [--repo <abs path>] [--worktree current|new:<type>/<task>|<orca selector>] [--title <text>]

The target repo is --repo, else the caller's cwd. It must be the Hub Session's repo (the bound Run's
`hub: <path>` objective); otherwise nothing is started. An explicit --repo elsewhere only warns.
Prints the `orca orchestration worker-start` JSON receipt. Exit code is non-zero on failure.
"""
import argparse
import json
import os
import shlex
import subprocess
import sys
import time
from pathlib import Path

HUB = Path(__file__).resolve().parent.parent
LAUNCH_DIR = Path.home() / ".agent-hub" / "launch"


def load_profile(name):
    path = HUB / "profiles" / f"{name}.md"
    if not path.exists():
        known = ", ".join(p.stem for p in sorted((HUB / "profiles").glob("*.md")))
        sys.exit(f"unknown profile {name!r}; known: {known}")
    text = path.read_text()
    _, front, body = text.split("---", 2)
    profile = {}
    for line in front.strip().splitlines():
        key, _, value = line.partition(":")
        profile[key.strip()] = value.strip()
    for key in ("tools", "skills", "context"):
        profile[key] = [v.strip() for v in profile.get(key, "").split(",") if v.strip()]
    profile["writes"] = profile.get("writes") == "true"
    profile["role"] = body.strip()
    if profile.get("cli") != "claude":
        sys.exit(f"profile {name}: cli {profile.get('cli')!r} is not supported yet (only claude)")
    return profile


def orca(*args):
    result = subprocess.run(["orca", *args, "--json"], capture_output=True, text=True)
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        sys.exit(f"orca {' '.join(args[:2])} failed: {result.stderr or result.stdout}")
    if result.returncode != 0 or not data.get("ok", True):
        print(json.dumps(data, indent=2))
        sys.exit(f"orca {' '.join(args[:2])} failed")
    return data["result"]


def wait_ready(handle):
    """Wait until the agent TUI is idle, accepting Claude's folder-trust prompt once.

    New worktrees are folders Claude has not seen; the human approved the Task, so trusting
    its worktree is part of starting it.
    """
    for attempt in range(2):
        result = subprocess.run(["orca", "terminal", "wait", "--terminal", handle, "--for", "tui-idle",
                                 "--timeout-ms", "60000", "--json"], capture_output=True, text=True)
        wait = json.loads(result.stdout)["result"]["wait"]
        if wait.get("satisfied"):
            return
        if wait.get("blockedReason") == "agent-trust-workspace" and attempt == 0:
            orca("terminal", "send", "--terminal", handle, "--text", "\x1b[B")
            time.sleep(1)
            orca("terminal", "send", "--terminal", handle, "--enter")
            time.sleep(5)  # the TUI reports idle on the stale dialog frame; let it redraw first
            continue
        print(json.dumps(wait, indent=2))
        sys.exit(f"worker terminal {handle} never became ready")


def system_prompt(profile):
    parts = [(HUB / "worker-contract.md").read_text()]
    parts.append("# Preferences\n\nApply these standing instructions from the human.\n\n"
                 + (HUB / "memory" / "preferences.md").read_text())
    parts.append(f"# Your role: {profile['name']}\n\n{profile['role']}")
    if profile["skills"]:
        parts.append("Use these skills when they fit the Task: " + ", ".join(profile["skills"]) + ".")
    if profile["context"]:
        parts.append("Before starting, read whichever of these files exist (paths relative to your "
                     "working directory unless absolute): " + ", ".join(profile["context"]) + ".")
    return "\n\n".join(parts)


BRANCH_TYPES = ("feat", "fix", "chore", "refactor", "docs", "test", "perf", "ci", "build")


def git_path(cwd, *args):
    result = subprocess.run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", *args],
                            capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else None


def ensure_registered(repo, checkout):
    """Register the repo with Orca if Orca cannot find this checkout, so Workers start here."""
    probe = subprocess.run(["orca", "worktree", "show", "--worktree", f"path:{checkout}", "--json"],
                           capture_output=True, text=True)
    if probe.returncode == 0 and json.loads(probe.stdout).get("ok"):
        return
    orca("repo", "add", "--path", repo)
    print(f"hub-worker: registered {repo} with Orca", file=sys.stderr)


def current_run():
    """The Run bound to the caller (the Orchestrator), or None."""
    result = subprocess.run(["orca", "orchestration", "run-current", "--json"], capture_output=True, text=True)
    try:
        return json.loads(result.stdout)["result"]["run"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return None


def hub_repo():
    """The Hub Session's repo from the bound Run's `hub: <path>` objective, or None."""
    objective = (current_run() or {}).get("objective", "")
    return objective[4:].strip() if objective.startswith("hub:") else None


def check_hub_repo(repo, checkout, explicit):
    """Refuse a Task aimed at a repo other than the Hub Session's, before any Orca mutation."""
    hub = hub_repo()
    if not hub or not os.path.isabs(hub):
        print("hub-worker: no Run bound to a `hub: <repo>` objective; repo guard skipped", file=sys.stderr)
        return
    if os.path.realpath(hub) in {os.path.realpath(repo), os.path.realpath(checkout)}:
        return
    if explicit:
        print(f"hub-worker: warning: --repo {repo} is not this Hub Session's repo {hub}", file=sys.stderr)
        return
    sys.exit(f"hub-worker: cwd repo {repo} is not this Hub Session's repo {hub}; "
             f"cd {hub} or pass --repo")


def resolve_worktree(choice, repo_arg):
    # Use explicit paths, not `active`: `active` only resolves when the caller runs in an
    # Orca-managed terminal, and the Orchestrator may not.
    start = repo_arg or os.getcwd()
    checkout = git_path(start, "--show-toplevel")
    if checkout is None and repo_arg:
        sys.exit(f"--repo {repo_arg} is not a git repository")
    checkout = checkout or start
    common = git_path(start, "--git-common-dir")
    repo = str(Path(common).parent) if common else checkout
    check_hub_repo(repo, checkout, bool(repo_arg))
    ensure_registered(repo, checkout)
    if choice == "current":
        return f"path:{checkout}"
    if choice.startswith("new:"):
        branch = choice[4:]
        kind, _, task = branch.partition("/")
        if kind not in BRANCH_TYPES or not task or "/" in task:
            sys.exit(f"--worktree new:{branch}: use new:<type>/<task>, type one of "
                     f"{', '.join(BRANCH_TYPES)} (e.g. new:feat/magic-link-login)")
        created = orca("worktree", "create", "--name", f"{kind}-{task}", "--repo", f"path:{repo}",
                       "--setup", "run")
        worktree = created.get("worktree", created)
        # Orca names the branch <git user>/<name>; Hub branches are <type>/<task>.
        rename = subprocess.run(["git", "-C", worktree["path"], "branch", "-m", branch],
                                capture_output=True, text=True)
        if rename.returncode != 0:
            sys.exit(f"could not name the worktree branch {branch}: {rename.stderr.strip()}")
        return f"path:{worktree['path']}"
    return choice  # any other Orca worktree selector, e.g. path:/abs/path


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("profile")
    spec = parser.add_mutually_exclusive_group(required=True)
    spec.add_argument("--spec")
    spec.add_argument("--spec-file")
    parser.add_argument("--repo")
    parser.add_argument("--worktree", default="current")
    parser.add_argument("--title")
    args = parser.parse_args()

    profile = load_profile(args.profile)
    task = args.spec if args.spec is not None else Path(args.spec_file).read_text()
    title = args.title or task.strip().splitlines()[0][:60]
    selector = resolve_worktree(args.worktree, args.repo)

    LAUNCH_DIR.mkdir(parents=True, exist_ok=True)
    stamp = f"{profile['name']}-{int(time.time() * 1000)}"
    prompt_file = LAUNCH_DIR / f"{stamp}.prompt.md"
    prompt_file.write_text(system_prompt(profile))
    argv = ["claude", "--model", profile["model"], "--permission-mode", "auto",
            "--settings", str(HUB / "settings" / "worker.json"),
            "--disallowedTools", "AskUserQuestion",
            "--add-dir", str(HUB), "-n", f"{profile['name']}: {title}"]
    if profile.get("effort"):
        argv += ["--effort", profile["effort"]]
    if profile["tools"]:
        argv += ["--tools", ",".join(profile["tools"])]
    script = LAUNCH_DIR / f"{stamp}.sh"
    run_id = (current_run() or {}).get("id", "")
    env = f"AGENT_HUB={shlex.quote(str(HUB))} HUB_RUN_ID={shlex.quote(run_id)}"
    script.write_text(f'#!/bin/sh\nexport {env}\nexec {shlex.join(argv)} --append-system-prompt "$(cat {shlex.quote(str(prompt_file))})"\n')
    script.chmod(0o755)

    terminal = orca("terminal", "create", "--worktree", selector,
                    "--title", f"{profile['name']}: {title}", "--command", str(script))
    handle = terminal.get("handle") or terminal["terminal"]["handle"]
    wait_ready(handle)

    receipt = orca("orchestration", "worker-start", "--spec", task, "--task-title",
                   f"{profile['name']}: {title}", "--terminal", handle, "--worktree", selector)
    if receipt.get("turnStart") != "observed":
        print(json.dumps(receipt, indent=2))
        sys.exit(f"worker {handle} accepted the Task but never started a turn; "
                 f"stop it with: orca orchestration worker-stop --dispatch {receipt.get('dispatchId')}")
    print(json.dumps({"profile": profile["name"], "terminal": handle, "worktree": selector,
                      "writes": profile["writes"], "receipt": receipt}, indent=2))


if __name__ == "__main__":
    main()
